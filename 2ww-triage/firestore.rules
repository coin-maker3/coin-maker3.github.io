rules_version = '2';

// 2WW Colorectal audit store.
//
// All access is denied to clients. Every read and write goes through the
// `api` Cloud Function, which uses the Admin SDK and bypasses these rules.
// There is no Firebase client SDK in the web app, so nothing in the browser
// ever touches Firestore directly. This keeps the audit dataset server-only
// and tamper-evident.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
