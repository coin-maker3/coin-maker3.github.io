# Copy to .env (gitignored). Never commit real secrets.

ENVIRONMENT=development           # development | production

# HARD RULE 5: unverified GMC rules are blocked in production. Dev-only escape:
ALLOW_UNVERIFIED_RULES=1

# HARD RULE 4: Gmail adapter (Phase 5) only exists behind this. Never set in a
# deployed public instance.
PERSONAL_MODE=0

# Extraction
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# Storage
MONGODB_URI=
MONGODB_DB=pathwaypack
